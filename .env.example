# Supabase project URL (from Supabase dashboard or local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose to browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — NEVER expose to browser, server-side only
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL (used for OAuth callbacks and email links)
NEXT_PUBLIC_APP_URL=
